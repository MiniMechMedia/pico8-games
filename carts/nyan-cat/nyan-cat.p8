pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- nyan cat
-- by ivoah
-- music by juju

stars={}
rnd_stars=8
red=8
t=0
frame=0

x=44
y=55

function update_stars()
 if flr(rnd(rnd_stars)) == 0 then
  add(stars,{128+3,
             flr(rnd(127)),
             flr(rnd(6))})
 end
 for star in all(stars) do
  star[1]-=3
  star[3]+=0.5
  if star[3]>=6 then
   star[3]=0
  end
  if star[1]<=0 then
   del(stars,star)
  end
 end
end

function draw_stars()
 rectfill(0,0,127,127,1)
 for star in all(stars) do
  spr(flr(star[3]),star[1],star[2])
 end
end

function draw_rainbow()
 for x=0,4 do
  for y=0,5 do
   if x%2==0 then offset=1
   else offset=0 end
   if t%8<4 then
    if offset==1 then
     offset=0
    else
     offset=1
    end
   end
   if x==4 and y==0 then
    w=12
   else
    w=10
   end
   rectfill(x*10,y*3+(64-6*3/2)+offset,x*10+w,y*3+(64-6*3/2)+3+offset,8+y)
  end
 end
--    pset(x,64-6*3/2+y*3+i+offset,red+y)

end

function draw_cat()
 if t%3==0 then
  frame+=1
  if frame>=6 then
   frame=0
  end
 end
-- x=128/2
-- y=128/2
 map(frame*5,0,x,y,5,3)
end

function _init()
 palt(0,false)
 palt(1,true)
 for i=0,7 do
  add(stars,{flr(rnd(127)),
             flr(rnd(127)),
             flr(rnd(6))})
 end
 music(0)
end

function _update()
 t+=1
 update_stars()
end

function _draw()
 draw_stars()
 draw_rainbow()
 draw_cat()
end


